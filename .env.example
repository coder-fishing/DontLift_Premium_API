PORT=3000
PUBLIC_BASE_URL=https://your-premium-api.example.com
FIREBASE_PROJECT_ID=august-monument-508716-u0
# Dùng đường dẫn tuyệt đối tới file JSON tải từ Firebase (khuyến nghị cho local).
