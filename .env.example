# Hoặc đặt JSON một dòng trong secret store trên host.
FIREBASE_SERVICE_ACCOUNT_JSON=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional allowlisted web origin. Native Expo Go không cần CORS origin.
WEB_ORIGIN=
